{
	"name": "to-bat-case",
	"version": "2.0.0",
	"description": "Convert a string to bat case.",
	"type": "module",
	"sideEffects": false,
	"main": "index.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"dictionary.js"
	],
	"scripts": {
		"check": "biome check --write .",
		"test": "node --test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sirlisko/to-bat-case.git"
	},
	"keywords": [
		"bat-case",
		"bat",
		"case",
		"string",
		"str",
		"text",
		"convert"
	],
	"author": "Luca Lischetti <luca@sirlisko.com> (https://sirlisko.com)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sirlisko/to-bat-case/issues"
	},
	"homepage": "https://github.com/sirlisko/to-bat-case#readme",
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.7.0"
}
